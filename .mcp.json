{
  "mcpServers": {
    "engram": {
      "type": "stdio",
      "command": "D:/Tools/engram.exe",
      "args": ["shim"],
      "env": {
        "ENGRAM_WORKSPACE": "D:\\Source\\GitHub\\graphtor-docs"
      },
      "tools": ["*"]
    },
    "backlogit": {
      "type": "stdio",
      "command": "backlogit",
      "args": ["mcp"],
      "env": {
        "BACKLOGIT_WORKSPACE": "D:\\Source\\GitHub\\graphtor-docs"
      },
      "tools": ["*"]
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "tools": ["*"]
    },
    "microsoft-docs": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": ["*"]
    },
    "agent-intercom": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-remote", "http://127.0.0.1:3000/mcp?workspace_id=graphtor-docs"],
      "tools": ["*"]
    },
    "tavily": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "npx -y mcp-remote (\"https://mcp.tavily.com/mcp/?tavilyApiKey=\" + $env:TAVILY_API_KEY)"
      ],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      },
      "tools": ["*"]
    },
    "github": {
      "type": "stdio",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-Command",
        "$env:GITHUB_PERSONAL_ACCESS_TOKEN = (gh auth token); npx -y @modelcontextprotocol/server-github"
      ],
      "tools": ["*"]
    }
  }
}
